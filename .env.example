# ============================================================
# Environment variables for agri-price-forecast
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit secrets.
# ============================================================

# --- Database ---
# Leave blank to use SQLite (default, no setup needed for dev)
# For PostgreSQL: postgresql://user:password@localhost:5432/agri_forecast
DATABASE_URL=

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- MLflow ---
# Leave blank to use local ./mlruns directory
MLFLOW_TRACKING_URI=

# --- Google Earth Engine (optional — for NDVI features) ---
# Get a free account at: https://earthengine.google.com
# Run: earthengine authenticate
# Then set the project name below
GEE_PROJECT=